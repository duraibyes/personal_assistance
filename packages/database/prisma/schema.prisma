generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loans             Loan[]
  expenses          Expense[]
  incomes           Income[]
  purchases         Purchase[]
  vehicles          Vehicle[]
  documents         Document[]
  expenseCategories ExpenseCategory[]
  recurringExpenses RecurringExpense[]
  trustedDevices    TrustedDevice[]
  professorMessages ProfessorMessage[]
}

/// A phone the user has signed in on. Lets the mobile app offer "Continue as …" after a reinstall.
/// deviceHash is an HMAC of the device id (keyed with JWT_SECRET) — the raw id is never stored.
model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceHash String
  deviceName String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, deviceHash])
  @@index([deviceHash])
}

/// Professor → Ask chat history, so a conversation is still there when the user comes back.
model ProfessorMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // user, assistant
  content   String
  /// "voice" when the question was spoken (content is the English transcript)
  source    String   @default("text")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ExpenseCategory {
  id       String  @id @default(uuid())
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])
  name     String
  type     String  @default("EXPENSE") // EXPENSE, INCOME, BOTH
  icon     String?
  isActive Boolean @default(true)
  isSystem Boolean @default(false)

  expenses          Expense[]
  incomes           Income[]
  recurringExpenses RecurringExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
}

model RecurringExpense {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  title           String
  amount          Float
  categoryId      String?
  category        ExpenseCategory? @relation(fields: [categoryId], references: [id])
  frequency       String // MONTHLY, QUARTERLY, HALF_YEARLY, YEARLY, CUSTOM
  nextDueDate     DateTime
  lastPaymentDate DateTime?
  paymentMethod   String
  notes           String?
  isActive        Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, nextDueDate])
}

model Loan {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  loanNumber        String?
  name              String
  lender            String
  loanType          String
  principalAmount   Float
  interestRate      Float
  tenureMonths      Int
  emiAmount         Float
  startDate         DateTime
  firstEmiDate      DateTime
  numberOfEmis      Int
  paidEmis          Int       @default(0)
  remainingEmis     Int
  outstandingAmount Float
  nextEmiDate       DateTime
  status            String    @default("ACTIVE") // ACTIVE, CLOSED, FORECLOSED
  foreclosureDate   DateTime?
  foreclosureAmount Float?
  processingFee     Float?
  insuranceAmount   Float?
  bouncingCharge    Float?
  lenderAddress     String?
  lenderContact     String?
  lenderEmail       String?
  appliedDate       DateTime?
  endDate           DateTime?
  documentId        String?
  isDeleted         Boolean   @default(false)

  attachments Document[]    @relation("LoanAttachments")
  payments    LoanPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, nextEmiDate])
}

model LoanPayment {
  id          String    @id @default(uuid())
  loanId      String
  loan        Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  emiNumber   Int
  dueDate     DateTime
  dueAmount   Float
  status      String    @default("PENDING") // PENDING, PAID, OVERDUE, PARTIAL
  paidAmount  Float?
  paymentDate DateTime?
  description String?
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([loanId, emiNumber])
  @@index([loanId, dueDate])
  @@index([status])
}

model Expense {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  amount        Float
  category      String
  categoryId    String?
  categoryRef   ExpenseCategory? @relation(fields: [categoryId], references: [id])
  description   String
  date          DateTime
  paymentMethod String
  vendorName    String?
  transactionId String?
  upiId         String?
  documentId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([categoryId])
}

model Income {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  amount      Float
  source      String
  categoryId  String?
  categoryRef ExpenseCategory? @relation(fields: [categoryId], references: [id])
  description String?
  date        DateTime
  documentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([categoryId])
}

model Purchase {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  amount       Float
  item         String
  category     String
  purchaseDate DateTime
  vendor       String?
  notes        String?
  documentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  name               String
  manufacturer       String
  model              String
  registrationNumber String?
  purchaseDate       DateTime?
  purchasePrice      Float?
  currentMileage     Int?

  services    VehicleService[]
  fuelEntries FuelEntry[]
  insurances  Insurance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleService {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  serviceDate DateTime
  mileage     Int
  serviceType String
  amount      Float
  workshop    String?
  notes       String?
  documentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FuelEntry {
  id            String   @id @default(uuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  date          DateTime
  amount        Float
  liters        Float
  pricePerLiter Float
  mileage       Int?
  station       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Insurance {
  id           String   @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  provider     String
  policyNumber String?
  startDate    DateTime
  expiryDate   DateTime
  premium      Float
  documentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id               String @id @default(uuid())
  userId           String
  user             User   @relation(fields: [userId], references: [id])
  fileName         String
  mimeType         String
  storageKey       String
  documentType     String
  processingStatus String @default("UPLOADED") // UPLOADED, PROCESSING, EXTRACTED, NEEDS_REVIEW, VERIFIED, FAILED

  loanId String?
  loan   Loan?   @relation("LoanAttachments", fields: [loanId], references: [id])

  extractions  DocumentExtraction[]
  loanPayments LoanPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentExtraction {
  id               String   @id @default(uuid())
  documentId       String
  document         Document @relation(fields: [documentId], references: [id])
  extractedText    String?
  structuredData   Json?
  processingStatus String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

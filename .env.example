# Mobile (Expo)
EXPO_PUBLIC_API_URL=https://wealthguard-api.vercel.app/api
EXPO_PUBLIC_WEB_URL=https://wealthguard-web.vercel.app

# Database (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth
JWT_SECRET=replace-with-a-long-random-string

# API
PORT=5000
CORS_ORIGIN=http://localhost:4000,https://wealthguard-web.vercel.app
NODE_ENV=development

# Web
NEXT_PUBLIC_API_URL=https://wealthguard-api.vercel.app/api

# Cloudinary (do not commit real secrets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=personal_assistant

# OCR
GEMINI_API_KEY=
